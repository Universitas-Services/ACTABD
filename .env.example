# PostgreSQL Database
# Runtime (app). En Cloud Run + Cloud SQL suele usar socket Unix:
# postgresql://USER:PASSWORD@localhost:5432/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase?schema=public"

# Conexión directa para migraciones (prisma migrate deploy).
# En Cloud SQL sin pooler puede ser igual a DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/mydatabase?schema=public"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key"

# Backend URL
BACKEND_URL="http://localhost:3001" # O la URL de tu API en producción

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Email Configuration (for Nodemailer)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="app@universitas.legal" # Use 'true' for SSL/TLS, 'false' otherwise

# Gateway ADK (reemplaza Dialogflow CX) — Cloud Run
ADK_GATEWAY_URL="https://gateway-actas-entrega-951100463087.us-east1.run.app"
# Opcional: timeout en ms (default 120000)
# ADK_GATEWAY_TIMEOUT_MS="120000"
